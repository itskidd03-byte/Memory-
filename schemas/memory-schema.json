{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/memory-schema.json",
  "title": "Autonomous Graphics Memory",
  "description": "Core memory schema for the autonomous graphics system, representing stored knowledge, departments, and asset state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memoryId",
    "name",
    "type",
    "status",
    "createdAt",
    "updatedAt",
    "content",
    "source"
  ],
  "properties": {
    "memoryId": {
      "type": "string",
      "description": "Unique memory identifier."
    },
    "name": {
      "type": "string",
      "description": "Memory label or title."
    },
    "type": {
      "type": "string",
      "enum": [
        "graphics",
        "environment",
        "character",
        "weapon",
        "animation",
        "weather",
        "lighting",
        "material",
        "wildlife",
        "building",
        "performance",
        "research",
        "report",
        "prompt",
        "learning",
        "api",
        "department",
        "schema",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived", "reviewed", "deprecated"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "department": {
      "type": ["string", "null"],
      "description": "Owning department or team."
    },
    "source": {
      "type": "string",
      "description": "Origin of the memory entry, such as training data, prompt, or report."
    },
    "content": {
      "type": "object",
      "description": "Structured memory payload.",
      "additionalProperties": true,
      "properties": {
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "relatedAssets": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "relatedDepartments": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "observations": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score for the memory state."
    },
    "references": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
